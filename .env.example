# Contact form email delivery (Resend)
# Without these, submissions are still logged to CONTACT_LEAD_LOG (JSONL) and console.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL_TO=info@plumbscape.co.uk
CONTACT_FROM_EMAIL=PlumbScape <onboarding@resend.dev>

# Optional: where submitted leads are persisted as JSON lines (default: logs/leads.jsonl)
CONTACT_LEAD_LOG=logs/leads.jsonl